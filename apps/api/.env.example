API_HOST=0.0.0.0
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/echo
REDIS_URL=redis://localhost:6379
DEPENDENCY_TIMEOUT_MS=5000

PUBLIC_API_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
EMAIL_ASSET_BASE_URL=https://assets.example.com
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# BETTER_AUTH_COOKIE_DOMAIN=

# Google sign-in. Set both values in every environment where the web app runs;
# the web app always shows the Google button. When they are absent the API
# boots without Google and email/password keeps working.
# Authorized redirect URI in Google Cloud Console:
#   ${PUBLIC_API_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

CHANNEL_CREDENTIALS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CHANNEL_CREDENTIALS_KEY_VERSION=v1

R2_ENDPOINT=https://account-id.eu.r2.cloudflarestorage.com
R2_BUCKET_NAME=echo-storage
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
KNOWLEDGE_UPLOAD_TOKEN_SECRET=change-me-use-at-least-32-random-bytes

AI_GATEWAY_API_KEY=replace-me
AI_CHAT_MODEL=openai/gpt-6-luna
# AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# POSTHOG_API_KEY=phc_replace_me
# POSTHOG_HOST=https://us.i.posthog.com
