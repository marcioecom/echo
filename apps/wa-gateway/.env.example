WA_GATEWAY_HOST=0.0.0.0
WA_GATEWAY_PORT=3003
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/echo
REDIS_URL=redis://localhost:6379
DEPENDENCY_TIMEOUT_MS=5000

CHANNEL_CREDENTIALS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CHANNEL_CREDENTIALS_KEY_VERSION=v1

WA_AUTH_FLUSH_MS=1000
WA_AUTH_BATCH_SIZE=25
WA_PAIRING_TIMEOUT_MS=180000
WA_SEND_INTERVAL_MS=1000
WA_CONTACT_INTERVAL_MS=3000
WA_COMPOSE_MS_PER_CHAR=30
WA_COMPOSE_MIN_MS=1000
WA_COMPOSE_MAX_MS=6000
