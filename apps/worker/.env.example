WORKER_HOST=0.0.0.0
WORKER_PORT=3002
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/echo
REDIS_URL=redis://localhost:6379
DEPENDENCY_TIMEOUT_MS=5000

RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Echo <onboarding@resend.dev>"

PUBLIC_API_URL=http://localhost:3001
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CHANNEL_CREDENTIALS_KEY_VERSION=v1

R2_ENDPOINT=https://account-id.eu.r2.cloudflarestorage.com
R2_BUCKET_NAME=echo-storage
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
AI_GATEWAY_API_KEY=replace-me
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_CHAT_MODEL=openai/gpt-6-luna
# Inbound WhatsApp audio is transcribed through the AI Gateway before the agent runs.
AI_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
AI_TRANSCRIPTION_TIMEOUT_MS=60000

# Optional: set both values to trace support-agent runs.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=echo

# Optional server-side product analytics. Leave POSTHOG_API_KEY unset to disable.
# In production these come from the Infisical /worker folder; the InfisicalSecret
# resource syncs the whole folder, so no Kubernetes manifest change is required.
# POSTHOG_API_KEY=phc_replace_me
POSTHOG_HOST=https://us.i.posthog.com
