# Inlined at build time for both the browser and the auth proxy.
# Local defaults match `pnpm dev` + `apps/api` on port 3001.
VITE_API_URL=http://localhost:3001
VITE_APP_URL=http://localhost:3000

# Shows "Continue with Google" on the auth pages. Defaults to false.
# It must match the API: only enable it after GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET are set in apps/api, and keep both disabled otherwise.
VITE_GOOGLE_AUTH_ENABLED=false

# Public Sentry DSN (org leapstark, project echo-web). Inlined at build time.
VITE_SENTRY_DSN=https://a48c60a1446c5ffe3c044b222d8b7af10@o4511162787561472.ingest.us.sentry.io/4512235409440768

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
